<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.AI - the core abstraction CogniChain builds on -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />

    <!-- Microsoft Agent Framework - CogniChain.Agents bridge -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />

    <!-- Model Context Protocol - example tool sourcing -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />

    <!-- Provider SDKs (examples only) -->
    <!-- OpenAI is pinned to the version Microsoft.Extensions.AI.OpenAI 11.0.1 declares a dependency on. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />

    <!-- Configuration (examples only) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

</Project>
