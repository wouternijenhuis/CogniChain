<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Not marked IsTrimmable: PromptTemplate.Render(object) and ChainBuilder.WithToolsFrom reflect over
      arbitrary user types by design (rendering a template against a POCO's properties; wrapping a
      service's methods as tools). Both are annotated [RequiresUnreferencedCode] so trimmed/AOT
      consumers get a warning at their call sites; use the dictionary-based Render overload or
      WithTools(AIFunctionFactory.Create(...)) instead when trimming.
    -->

    <!-- Package identity -->
    <PackageId>CogniChain</PackageId>
    <Version>0.3.0</Version>
    <Authors>Wouter Nijenhuis (DevDad.net)</Authors>
    <Company>Wouter Nijenhuis (DevDad.net)</Company>
    <Copyright>Copyright © 2026 Wouter Nijenhuis — DevDad.net</Copyright>

    <!-- Package description -->
    <Title>CogniChain</Title>
    <Description>Typed, composable chain steps over Microsoft.Extensions.AI's IChatClient. Prompt templates, structured output, tool calling via AIFunction, resilient middleware, and real token streaming for .NET LLM applications.</Description>
    <Summary>A typed chain layer over Microsoft.Extensions.AI for building LLM-powered .NET applications.</Summary>

    <!-- Package discoverability -->
    <PackageTags>LLM;AI;Microsoft.Extensions.AI;IChatClient;OpenAI;Chains;Prompts;Agent;Orchestration;dotnet;csharp;machine-learning;artificial-intelligence;chatbot;workflow;devdad</PackageTags>

    <!-- Package licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Package links -->
    <PackageProjectUrl>https://github.com/wouternijenhuis/CogniChain</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wouternijenhuis/CogniChain</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Package assets -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Package release notes - link to changelog -->
    <PackageReleaseNotes>See https://github.com/wouternijenhuis/CogniChain/blob/main/CHANGELOG.md for release notes.</PackageReleaseNotes>

    <!-- Deterministic builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- Package assets -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
